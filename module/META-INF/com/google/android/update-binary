#!/sbin/sh
#################
# Initialization
#################
umask 022

ui_print() { echo "$1"; }

require_new_ksu() {
  ui_print "**********************************"
  ui_print " Please use KernelSU / APatch / Magisk v20.4+! "
  ui_print "**********************************"
  exit 1
}

#########################
# Load util_functions.sh
#########################
OUTFD=$2
ZIPFILE=$3

mount /data 2>/dev/null
[ -f /data/adb/magisk/util_functions.sh ] && . /data/adb/magisk/util_functions.sh
[ -f /data/adb/ksu/bin/busybox ] && BUSYBOX=/data/adb/ksu/bin/busybox
[ -f /data/adb/ap/bin/busybox ] && BUSYBOX=/data/adb/ap/bin/busybox

if type install_module >/dev/null 2>&1; then
  install_module
  exit 0
fi

# Fallback direct extraction if util_functions.sh is not used
MODID="llc_susfs_localizer"
MODPATH="/data/adb/modules_update/${MODID}"
mkdir -p "$MODPATH"
if [ -n "$BUSYBOX" ]; then
  "$BUSYBOX" unzip -o "$ZIPFILE" -x 'META-INF/*' -d "$MODPATH" >&2
else
  unzip -o "$ZIPFILE" -x 'META-INF/*' -d "$MODPATH" >&2
fi

set_perm() {
  chown "$2:$3" "$1" 2>/dev/null
  chmod "$4" "$1" 2>/dev/null
}

set_perm_recursive() {
  find "$1" -type d -exec chown "$2:$3" {} + -exec chmod "$4" {} + 2>/dev/null
  find "$1" -type f -exec chown "$2:$3" {} + -exec chmod "$5" {} + 2>/dev/null
}

[ -f "$MODPATH/customize.sh" ] && . "$MODPATH/customize.sh"
exit 0
